BASE <https://w3id.org/hacid/data/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX sig: <https://w3id.org/sig/>
PREFIX sigdata: <sig/>
PREFIX siglevels: <sig/levels/>
PREFIX sigs: <sig/signatures/>

SELECT
  ?sig_level ?sig_level_value
  (COUNT(DISTINCT ?sig) AS ?signatures)
  (COUNT(1) AS ?instances)
WHERE {
  GRAPH sigdata:graph {
	?sig_level a sig:SignatureLevel;
		sig:levelValue ?sig_level_value.
	?sig a sig:NodeSignature;
		sig:level ?sig_level.
	?s sig:hasNodeSignature ?sig
  }
}
GROUP BY ?sig_level ?sig_level_value
ORDER BY ?sig_level_value
